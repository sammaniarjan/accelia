# Supabase — maak een nieuw project aan op https://supabase.com en kopieer deze waardes uit Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Haiku voor extractie, Sonnet voor schrijven/redenering)
ANTHROPIC_API_KEY=

# OpenAI — alleen gebruikt voor embeddings (text-embedding-3-small, 1536 dim)
OPENAI_API_KEY=

# Optioneel: Supabase storage bucket-naam voor PDF-uploads (default: documents)
SUPABASE_STORAGE_BUCKET=documents

# Basic auth — alleen actief als BASIC_AUTH_PASSWORD gezet is.
# Lokaal: leeg laten zodat de site open staat. Op Vercel: WEL invullen.
BASIC_AUTH_USER=accelia
BASIC_AUTH_PASSWORD=
